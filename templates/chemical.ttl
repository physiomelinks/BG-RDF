#===============================================================================

bgf:MichaelisMentenReactionNode
    a bgf:CompositeTemplate ;
    rdfs:label "Irreversible Michaelis-Menten reaction with One Node" ;
    rdfs:subClassOf bgf:MichaelisMentenReaction ;
    rdfs:subClassOf bgf:OneReactionNode .

bgf:KedemKatchalskySoluteFluxNode
    a bgf:CompositeTemplate ;
    rdfs:label "Kedem-Katchalsky solute flux with One Node" ;
    rdfs:subClassOf bgf:KedemKatchalskySoluteFlux ;
    rdfs:subClassOf bgf:OneReactionNode .

bgf:ConvectiveSoluteFluxNode
    a bgf:CompositeTemplate ;
    rdfs:label "Solute carried by a water flow, with One Node" ;
    rdfs:subClassOf bgf:ConvectiveSoluteFlux ;
    rdfs:subClassOf bgf:OneReactionNode .

bgf:NKEPumpNode
    a bgf:CompositeTemplate ;
    rdfs:label "Na/K-ATPase pump with One Node" ;
    rdfs:subClassOf bgf:NKEPump ;
    rdfs:subClassOf bgf:OneReactionNode .

bgf:SignalFluxNode
    a bgf:CompositeTemplate ;
    rdfs:label "Flux set by a signal with One Node" ;
    rdfs:subClassOf bgf:SignalFlux ;
    rdfs:subClassOf bgf:OneReactionNode .

