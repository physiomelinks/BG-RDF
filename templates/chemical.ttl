@prefix bgf: <https://bg-rdf.org/ontologies/bondgraph-framework#> .
@prefix cdt: <https://w3id.org/cdt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#===============================================================================

bgf:Chemical
    a bgf:PhysicalDomain ;
    bgf:hasConstant [
        bgf:varName "RT" ;
        bgf:hasValue "2578.73058 J/mol"^^cdt:ucum
    ], [
        bgf:varName "F" ;
        rdfs:label "Faraday's constant" ;
        bgf:hasValue "0.96485e5 C/mol"^^cdt:ucum
    ] ;
    bgf:hasFlow [
        bgf:varName "v" ;
        bgf:hasUnits "mol/s"^^cdt:ucumunit
    ] ;
    bgf:hasPotential [
        bgf:varName "u" ;
        bgf:hasUnits "J/mol"^^cdt:ucumunit
    ] ;
    bgf:hasQuantity [
        bgf:varName "q" ;
        rdfs:label "Chemical quantity (mol)" ;
        bgf:hasUnits "mol"^^cdt:ucumunit
    ] .


#===============================================================================

bgf:ChemicalPotential
    a bgf:ElementTemplate ;
    rdfs:subClassOf bgf:PotentialSource ;
    bgf:hasDomain bgf:Chemical .

bgf:ChemicalFlow
    a bgf:ElementTemplate ;
    rdfs:subClassOf bgf:FlowSource ;
    bgf:hasDomain bgf:Chemical .

#===============================================================================

bgf:ChemicalReaction
    a bgf:ElementTemplate ;
    rdfs:subClassOf bgf:Reaction ;
    bgf:hasDomain bgf:Chemical ;
    rdfs:label "Chemical reaction" ;
    bgf:hasPort [
        bgf:portId 'f' ;
        bgf:direction bgf:InwardPort
    ], [
        bgf:portId 'r' ;
        bgf:direction bgf:OutwardPort
    ] ;
    bgf:hasParameter [
        bgf:varName "kappa" ;
        bgf:hasUnits "mol/s"^^cdt:ucumunit
    ] ;
    # v = kappa*(exp(u_f/RT) - exp(u_r/RT))
    bgf:constitutiveRelation """
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <times/>
                    <ci>kappa</ci>
                    <apply>
                        <minus/>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <ci>u_f</ci>
                                <ci>RT</ci>
                            </apply>
                        </apply>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <ci>u_r</ci>
                                <ci>RT</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
    """^^bgf:mathml .

#===============================================================================

bgf:ChemicalConcentration
    a bgf:ElementTemplate ;
    rdfs:subClassOf bgf:QuantityStore ;
    bgf:hasDomain bgf:Chemical ;
    rdfs:label "Chemical concentration" ;
    bgf:hasParameter [
        bgf:varName "K" ;
        bgf:hasUnits "mol-1"^^cdt:ucumunit
    ] ;
    # ode(q, t) = v
    # u = RT*ln(K*q);
    bgf:constitutiveRelation """
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q</ci>
                </apply>
                <ci>v</ci>
            </apply>
            <apply>
                <eq/>
                <ci>u</ci>
                <apply>
                    <times/>
                    <ci>RT</ci>
                    <apply>
                        <ln/>
                        <apply>
                            <times/>
                            <ci>K</ci>
                            <ci>q</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
    """^^bgf:mathml .

#===============================================================================

bgf:SaturatingChemicalReaction
    a bgf:ElementTemplate ;
    rdfs:subClassOf bgf:Reaction ;
    bgf:hasDomain bgf:Chemical ;
    rdfs:label "Saturating chemical reaction" ;
    bgf:lawLabel "sat" ;
    bgf:hasStyle [
        a bgf:ElementStyle ;
        bgf:textColour "#72329F" ;
        bgf:backgroundColour "#FFE9A8" ;
        bgf:borderColour "#C55A11" ;
        bgf:borderStyle "dashed"
    ] ;
    bgf:hasPort [
        bgf:portId 'f' ;
        bgf:direction bgf:InwardPort
    ], [
        bgf:portId 'r' ;
        bgf:direction bgf:OutwardPort
    ] ;
    bgf:hasParameter [
        bgf:varName "kappa" ;
        bgf:hasUnits "mol/s"^^cdt:ucumunit
    ], [
        bgf:varName "sigma" ;
        rdfs:label "Saturation (half-saturated where exp(u_f/RT) + exp(u_r/RT) = sigma)" ;
        bgf:hasUnits "1"^^cdt:ucumunit
    ] ;
    # v = kappa*(exp(u_f/RT) - exp(u_r/RT))/(1 + (exp(u_f/RT) + exp(u_r/RT))/sigma)
    # The mass-action reaction slowed as its substrates or products build up; its equilibrium is unchanged, and it
    # tends to the Chemical reaction as sigma grows.
    bgf:constitutiveRelation """
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>kappa</ci>
                        <apply>
                            <minus/>
                            <apply>
                                <exp/>
                                <apply><divide/><ci>u_f</ci><ci>RT</ci></apply>
                            </apply>
                            <apply>
                                <exp/>
                                <apply><divide/><ci>u_r</ci><ci>RT</ci></apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <cn>1</cn>
                        <apply>
                            <divide/>
                            <apply>
                                <plus/>
                                <apply>
                                    <exp/>
                                    <apply><divide/><ci>u_f</ci><ci>RT</ci></apply>
                                </apply>
                                <apply>
                                    <exp/>
                                    <apply><divide/><ci>u_r</ci><ci>RT</ci></apply>
                                </apply>
                            </apply>
                            <ci>sigma</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
    """^^bgf:mathml .

#===============================================================================

bgf:SaturatingChemicalConcentration
    a bgf:ElementTemplate ;
    rdfs:subClassOf bgf:QuantityStore ;
    bgf:hasDomain bgf:Chemical ;
    rdfs:label "Chemical concentration with saturating activity" ;
    bgf:lawLabel "sat" ;
    bgf:hasStyle [
        a bgf:ElementStyle ;
        bgf:textColour "#00B050" ;
        bgf:backgroundColour "#D6EAF8" ;
        bgf:borderColour "#2E75B6" ;
        bgf:borderStyle "dashed"
    ] ;
    bgf:hasParameter [
        bgf:varName "K" ;
        bgf:hasUnits "mol-1"^^cdt:ucumunit
    ], [
        bgf:varName "k_sat" ;
        rdfs:label "Amount at which the activity is half its ideal value" ;
        bgf:hasUnits "mol"^^cdt:ucumunit
    ] ;
    # ode(q, t) = v
    # u = RT*ln(K*q*k_sat/(k_sat + q))
    # A store whose activity saturates (a polymer's chain ends, binding sites): ideal while q << k_sat.
    bgf:constitutiveRelation """
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q</ci>
                </apply>
                <ci>v</ci>
            </apply>
            <apply>
                <eq/>
                <ci>u</ci>
                <apply>
                    <times/>
                    <ci>RT</ci>
                    <apply>
                        <ln/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <ci>K</ci>
                                <ci>q</ci>
                                <ci>k_sat</ci>
                            </apply>
                            <apply>
                                <plus/>
                                <ci>k_sat</ci>
                                <ci>q</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
    """^^bgf:mathml .

#===============================================================================

bgf:NKETransporter
    a bgf:ElementTemplate ;
    rdfs:subClassOf bgf:Reaction ;
    bgf:hasDomain bgf:Chemical ;
    bgf:hasSymbol "NKE" ;
    bgf:hasPort [
        bgf:portId 'K_f' ;
        bgf:direction bgf:InwardPort ;
        bgf:bondCount 2
    ], [
        bgf:portId 'K_r' ;
        bgf:direction bgf:OutwardPort ;
        bgf:bondCount 2
    ], [
        bgf:portId 'Na_f' ;
        bgf:direction bgf:InwardPort ;
        bgf:bondCount 3
    ], [
        bgf:portId 'Na_r' ;
        bgf:direction bgf:OutwardPort ;
        bgf:bondCount 3
    ] ;
    bgf:hasParameter [
        bgf:varName "k_NKE" ;
        bgf:hasUnits "mol/s"^^cdt:ucumunit
    ], [
        bgf:varName "K_K";
        bgf:hasUnits "L/mol"^^cdt:ucumunit
    ], [
        bgf:varName "K_Na" ;
        bgf:hasUnits "L/mol"^^cdt:ucumunit
    ], [
        bgf:varName "u_e";
        bgf:hasUnits "J/C"^^cdt:ucumunit
    ] ;
    bgf:hasVariable [
        bgf:varName "q_H2O_in" ;
        bgf:hasUnits "L"^^cdt:ucumunit
    ], [
        bgf:varName "q_H2O_out" ;
        bgf:hasUnits "L"^^cdt:ucumunit
    ], [
        bgf:varName "q_Na_in" ;
        bgf:hasUnits "mol"^^cdt:ucumunit
    ], [
        bgf:varName "q_Na_out" ;
        bgf:hasUnits "mol"^^cdt:ucumunit
    ], [
        bgf:varName "q_K_in" ;
        bgf:hasUnits "mol"^^cdt:ucumunit
    ], [
        bgf:varName "q_K_out" ;
        bgf:hasUnits "mol"^^cdt:ucumunit
    ] ;
    bgf:constitutiveRelation """
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>k_NKE</ci>
                        <cn>3</cn>
                        <apply>
                            <minus/>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_Na</ci>
                                            <ci>q_Na_in</ci>
                                        </apply>
                                        <ci>q_H2O_in</ci>
                                    </apply>
                                    <cn>3</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_K</ci>
                                            <ci>q_K_out</ci>
                                        </apply>
                                        <ci>q_H2O_out</ci>
                                    </apply>
                                    <cn>2</cn>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_Na</ci>
                                            <ci>q_Na_out</ci>
                                        </apply>
                                        <ci>q_H2O_out</ci>
                                    </apply>
                                    <cn>3</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_K</ci>
                                            <ci>q_K_in</ci>
                                        </apply>
                                        <ci>q_H2O_in</ci>
                                    </apply>
                                    <cn>2</cn>
                                </apply>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <cn>2</cn>
                                            <ci>F</ci>
                                            <ci>u_e</ci>
                                        </apply>
                                        <ci>RT</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <cn>1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_Na</ci>
                                        <ci>q_Na_in</ci>
                                    </apply>
                                    <ci>q_H2O_in</ci>
                                </apply>
                                <cn>3</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn>1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_Na</ci>
                                        <ci>q_Na_out</ci>
                                    </apply>
                                    <ci>q_H2O_out</ci>
                                </apply>
                                <cn>3</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn>1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_K</ci>
                                        <ci>q_K_out</ci>
                                    </apply>
                                    <ci>q_H2O_out</ci>
                                </apply>
                                <cn>2</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn>1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_K</ci>
                                        <ci>q_K_in</ci>
                                    </apply>
                                    <ci>q_H2O_in</ci>
                                </apply>
                                <cn>2</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
    """^^bgf:mathml .

#===============================================================================

bgf:ChemicalStorageNode
    a bgf:CompositeTemplate ;
    rdfs:label "Chemical storage with Zero Node" ;
    rdfs:subClassOf bgf:ChemicalConcentration ;
    rdfs:subClassOf bgf:ZeroStorageNode .

#===============================================================================

bgf:ChemicalReactionNode
    a bgf:CompositeTemplate ;
    rdfs:label "Chemical reaction with One Node" ;
    rdfs:subClassOf bgf:ChemicalReaction ;
    rdfs:subClassOf bgf:OneReactionNode .

#===============================================================================

bgf:SaturatingChemicalStorageNode
    a bgf:CompositeTemplate ;
    rdfs:label "Chemical storage with saturating activity and Zero Node" ;
    rdfs:subClassOf bgf:SaturatingChemicalConcentration ;
    rdfs:subClassOf bgf:ZeroStorageNode .

bgf:SaturatingChemicalReactionNode
    a bgf:CompositeTemplate ;
    rdfs:label "Saturating chemical reaction with One Node" ;
    rdfs:subClassOf bgf:SaturatingChemicalReaction ;
    rdfs:subClassOf bgf:OneReactionNode .

#===============================================================================

bgf:NKETransporterNode
    a bgf:CompositeTemplate ;
    rdfs:label "NKE transporter with One Node" ;
    rdfs:subClassOf bgf:NKETransporter ;
    rdfs:subClassOf bgf:OneReactionNode .

#===============================================================================
#===============================================================================

# Reactions driven by signals as well as by their substrates' potentials: an irreversible Michaelis-Menten reaction
# whose enzyme amount is a signal, and solute fluxes set by concentrations and a water flux (Kedem-Katchalsky
# transport with bgf:KedemKatchalskyWaterFlux, and convection). Any parameter can be scaled by a signal (a
# bgf:SignalBond with bgf:modulates), e.g. an Na/K-ATPase's k_NKE by aldosterone.

#===============================================================================

bgf:MichaelisMentenReaction
    a bgf:ElementTemplate ;
    rdfs:subClassOf bgf:Reaction ;
    bgf:hasDomain bgf:Chemical ;
    rdfs:label "Irreversible Michaelis-Menten reaction" ;
    bgf:lawLabel "MM" ;
    bgf:hasStyle [
        a bgf:ElementStyle ;
        bgf:textColour "#72329F" ;
        bgf:backgroundColour "#FFE9A8" ;
        bgf:borderColour "#2F5597" ;
        bgf:borderStyle "double"
    ] ;
    bgf:hasPort [
        bgf:portId 'f' ;
        bgf:direction bgf:InwardPort
    ], [
        bgf:portId 'r' ;
        bgf:direction bgf:OutwardPort
    ] ;
    bgf:hasParameter [
        bgf:varName "kcat" ;
        rdfs:label "Turnover number (per s)" ;
        bgf:hasUnits "s-1"^^cdt:ucumunit
    ], [
        bgf:varName "Km" ;
        rdfs:label "Half-saturating activity of the substrate, exp(u_f/RT) (K times its half-saturating amount)" ;
        bgf:hasUnits "1"^^cdt:ucumunit
    ], [
        bgf:varName "a" ;
        rdfs:label "Enzyme activity (1, less with an inhibitor)" ;
        bgf:hasUnits "1"^^cdt:ucumunit
    ] ;
    bgf:hasSignalInput [
        bgf:varName "E" ;
        rdfs:label "Enzyme amount (mol)" ;
        bgf:hasUnits "mol"^^cdt:ucumunit
    ] ;
    # v = kcat*a*E*exp(u_f/RT)/(exp(u_f/RT) + Km); the product's potential does not slow it
    bgf:constitutiveRelation """
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>kcat</ci>
                        <ci>a</ci>
                        <ci>E</ci>
                        <apply><exp/><apply><divide/><ci>u_f</ci><ci>RT</ci></apply></apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply><exp/><apply><divide/><ci>u_f</ci><ci>RT</ci></apply></apply>
                        <ci>Km</ci>
                    </apply>
                </apply>
            </apply>
        </math>
    """^^bgf:mathml .

#===============================================================================

bgf:KedemKatchalskySoluteFlux
    a bgf:ElementTemplate ;
    rdfs:subClassOf bgf:Reaction ;
    bgf:hasDomain bgf:Chemical ;
    rdfs:label "Kedem-Katchalsky solute flux" ;
    bgf:hasSymbol "J" ;
    bgf:lawLabel "KK" ;
    bgf:hasStyle [
        a bgf:ElementStyle ;
        bgf:textColour "#72329F" ;
        bgf:backgroundColour "#DDEBF7" ;
        bgf:borderColour "#2F5597" ;
        bgf:borderStyle "double"
    ] ;
    bgf:hasPort [
        bgf:portId 'f' ;
        bgf:direction bgf:InwardPort
    ], [
        bgf:portId 'r' ;
        bgf:direction bgf:OutwardPort
    ] ;
    bgf:hasParameter [
        bgf:varName "omega" ;
        rdfs:label "Solute permeability (L/s)" ;
        bgf:hasUnits "L/s"^^cdt:ucumunit
    ], [
        bgf:varName "sigma" ;
        rdfs:label "Reflection coefficient" ;
        bgf:hasUnits "1"^^cdt:ucumunit
    ] ;
    bgf:hasSignalInput [
        bgf:varName "c_in" ;
        rdfs:label "Concentration inside (mol/L)" ;
        bgf:hasUnits "mol/L"^^cdt:ucumunit
    ], [
        bgf:varName "c_out" ;
        rdfs:label "Concentration outside (mol/L)" ;
        bgf:hasUnits "mol/L"^^cdt:ucumunit
    ], [
        bgf:varName "Jv" ;
        rdfs:label "Water flux (L/s), from a bgf:KedemKatchalskyWaterFlux" ;
        bgf:hasUnits "L/s"^^cdt:ucumunit
    ] ;
    # Js = omega*(c_in - c_out) + (1 - sigma)*(c_in + c_out)/2*Jv
    bgf:constitutiveRelation """
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>omega</ci>
                        <apply><minus/><ci>c_in</ci><ci>c_out</ci></apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply><minus/><cn>1</cn><ci>sigma</ci></apply>
                        <apply><divide/><apply><plus/><ci>c_in</ci><ci>c_out</ci></apply><cn>2</cn></apply>
                        <ci>Jv</ci>
                    </apply>
                </apply>
            </apply>
        </math>
    """^^bgf:mathml .

#===============================================================================

bgf:ConvectiveSoluteFlux
    a bgf:ElementTemplate ;
    rdfs:subClassOf bgf:Reaction ;
    bgf:hasDomain bgf:Chemical ;
    rdfs:label "Solute carried by a water flow" ;
    bgf:hasSymbol "J" ;
    bgf:lawLabel "cv" ;
    bgf:hasStyle [
        a bgf:ElementStyle ;
        bgf:textColour "#72329F" ;
        bgf:backgroundColour "#DDEBF7" ;
        bgf:borderColour "#2F5597" ;
        bgf:borderStyle "dashed"
    ] ;
    bgf:hasPort [
        bgf:portId 'f' ;
        bgf:direction bgf:InwardPort
    ], [
        bgf:portId 'r' ;
        bgf:direction bgf:OutwardPort
    ] ;
    bgf:hasSignalInput [
        bgf:varName "c" ;
        rdfs:label "Concentration of the water carrying it (mol/L)" ;
        bgf:hasUnits "mol/L"^^cdt:ucumunit
    ], [
        bgf:varName "Jv" ;
        rdfs:label "Water flow (L/s)" ;
        bgf:hasUnits "L/s"^^cdt:ucumunit
    ] ;
    # v = c*Jv
    bgf:constitutiveRelation """
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v</ci>
                <apply><times/><ci>c</ci><ci>Jv</ci></apply>
            </apply>
        </math>
    """^^bgf:mathml .

#===============================================================================

bgf:NKEPump
    a bgf:ElementTemplate ;
    rdfs:subClassOf bgf:Reaction ;
    bgf:hasDomain bgf:Chemical ;
    rdfs:label "Na/K-ATPase: Na pumped out of a cell by ATP, against the membrane potential" ;
    bgf:hasSymbol "NKE" ;
    bgf:lawLabel "NKE" ;
    bgf:hasStyle [
        a bgf:ElementStyle ;
        bgf:textColour "#72329F" ;
        bgf:backgroundColour "#FFF2CC" ;
        bgf:borderColour "#C00000" ;
        bgf:borderStyle "double"
    ] ;
    bgf:hasPort [
        bgf:portId 'f' ;
        bgf:direction bgf:InwardPort
    ], [
        bgf:portId 'r' ;
        bgf:direction bgf:OutwardPort
    ] ;
    bgf:hasParameter [
        bgf:varName "k_NKE" ;
        rdfs:label "Rate constant (mol/s; the Na flux is 3 per cycle)" ;
        bgf:hasUnits "mol/s"^^cdt:ucumunit
    ], [
        bgf:varName "K_ATP" ;
        rdfs:label "ATP drive exp(-dG_ATP/RT) (1 leaves it out)" ;
        bgf:hasUnits "1"^^cdt:ucumunit
    ], [
        bgf:varName "K_Na" ;
        rdfs:label "Na affinity (L/mol)" ;
        bgf:hasUnits "L/mol"^^cdt:ucumunit
    ], [
        bgf:varName "K_K" ;
        rdfs:label "K affinity (L/mol)" ;
        bgf:hasUnits "L/mol"^^cdt:ucumunit
    ], [
        bgf:varName "u_e" ;
        rdfs:label "Membrane potential (V), inside relative to outside; a signal may set it" ;
        bgf:hasUnits "J/C"^^cdt:ucumunit
    ] ;
    bgf:hasSignalInput [
        bgf:varName "c_Na_i" ;
        rdfs:label "Na inside the cell, where the pump takes it from (mol/L)" ;
        bgf:hasUnits "mol/L"^^cdt:ucumunit
    ], [
        bgf:varName "c_Na_o" ;
        rdfs:label "Na outside, where the pump puts it (mol/L)" ;
        bgf:hasUnits "mol/L"^^cdt:ucumunit
    ], [
        bgf:varName "c_K_i" ;
        rdfs:label "K inside (mol/L)" ;
        bgf:hasUnits "mol/L"^^cdt:ucumunit
    ], [
        bgf:varName "c_K_o" ;
        rdfs:label "K outside (mol/L)" ;
        bgf:hasUnits "mol/L"^^cdt:ucumunit
    ] ;
    # 3 Na_i + 2 K_o + ATP <-> 3 Na_o + 2 K_i + ADP + Pi, moving one charge out; v is the Na flux:
    # v = 3 k_NKE (K_ATP (K_Na c_Na_i)^3 (K_K c_K_o)^2 - (K_Na c_Na_o)^3 (K_K c_K_i)^2 exp(2 F u_e/RT))
    #     / ((1 + (K_Na c_Na_i)^3) (1 + (K_Na c_Na_o)^3) (1 + (K_K c_K_o)^2) (1 + (K_K c_K_i)^2))
    bgf:constitutiveRelation """
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn>3</cn>
                        <ci>k_NKE</ci>
                        <apply>
                            <minus/>
                            <apply>
                                <times/>
                                <ci>K_ATP</ci>
                                <apply><power/><apply><times/><ci>K_Na</ci><ci>c_Na_i</ci></apply><cn>3</cn></apply>
                                <apply><power/><apply><times/><ci>K_K</ci><ci>c_K_o</ci></apply><cn>2</cn></apply>
                            </apply>
                            <apply>
                                <times/>
                                <apply><power/><apply><times/><ci>K_Na</ci><ci>c_Na_o</ci></apply><cn>3</cn></apply>
                                <apply><power/><apply><times/><ci>K_K</ci><ci>c_K_i</ci></apply><cn>2</cn></apply>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply><times/><cn>2</cn><ci>F</ci><ci>u_e</ci></apply>
                                        <ci>RT</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply><plus/><cn>1</cn><apply><power/><apply><times/><ci>K_Na</ci><ci>c_Na_i</ci></apply><cn>3</cn></apply></apply>
                        <apply><plus/><cn>1</cn><apply><power/><apply><times/><ci>K_Na</ci><ci>c_Na_o</ci></apply><cn>3</cn></apply></apply>
                        <apply><plus/><cn>1</cn><apply><power/><apply><times/><ci>K_K</ci><ci>c_K_o</ci></apply><cn>2</cn></apply></apply>
                        <apply><plus/><cn>1</cn><apply><power/><apply><times/><ci>K_K</ci><ci>c_K_i</ci></apply><cn>2</cn></apply></apply>
                    </apply>
                </apply>
            </apply>
        </math>
    """^^bgf:mathml .

#===============================================================================

bgf:SignalFlux
    a bgf:ElementTemplate ;
    rdfs:subClassOf bgf:Reaction ;
    bgf:hasDomain bgf:Chemical ;
    rdfs:label "Flux set by a signal" ;
    bgf:hasSymbol "J" ;
    bgf:lawLabel "set" ;
    bgf:hasStyle [
        a bgf:ElementStyle ;
        bgf:textColour "#72329F" ;
        bgf:backgroundColour "#F2F2F2" ;
        bgf:borderColour "#7F7F7F" ;
        bgf:borderStyle "dashed"
    ] ;
    bgf:hasPort [
        bgf:portId 'f' ;
        bgf:direction bgf:InwardPort
    ], [
        bgf:portId 'r' ;
        bgf:direction bgf:OutwardPort
    ] ;
    bgf:hasSignalInput [
        bgf:varName "J" ;
        rdfs:label "The flux (mol/s), e.g. from a law built of signal blocks" ;
        bgf:hasUnits "mol/s"^^cdt:ucumunit
    ] ;
    # v = J: a flow from one side to the other that a signal sets (a modulated flow source between two nodes)
    bgf:constitutiveRelation """
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><eq/><ci>v</ci><ci>J</ci></apply>
        </math>
    """^^bgf:mathml .

